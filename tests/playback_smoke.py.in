#!/usr/bin/env python3
"""Headless, deterministic local playback checks for the core stack."""

import functools
import http.server
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time


PLAYER = Path('@player@')
PLUGIN_PATHS = '@plugin_paths@'.split(';')
COMMAND_TIMEOUT = 20


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, _format, *_args):
        pass


def run_checked(command, *, env, label):
    try:
        completed = subprocess.run(
            command,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=COMMAND_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f'{label} timed out') from error
    if completed.returncode != 0:
        raise RuntimeError(
            f'{label} failed with exit code {completed.returncode}:\n'
            f'{completed.stdout}'
        )
    return completed.stdout


def read_log_tail(path, limit=8192):
    with open(path, 'rb') as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - limit))
        return handle.read(limit).decode('utf-8', errors='replace')


def play(uri, *, env, label, diag_log=None):
    """Start a player graph, allow it to initialise, then quit cleanly."""
    log_handle = open(diag_log, 'wb') if diag_log is not None else None
    try:
        process = subprocess.Popen(
            [str(PLAYER), uri],
            env=env,
            stdin=subprocess.PIPE,
            stdout=log_handle if log_handle is not None else subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=log_handle is None,
        )
    except OSError as error:
        if log_handle is not None:
            try:
                log_handle.close()
            except OSError:
                pass
        raise RuntimeError(f'{label} could not start: {error}') from error

    def diag_cleanup_tail():
        try:
            log_handle.flush()
        except OSError:
            pass
        try:
            return read_log_tail(diag_log)
        except OSError:
            return '<diagnostic evidence unavailable (inconclusive)>'

    def diag_terminate_reap():
        try:
            process.send_signal(signal.SIGTERM)
        except OSError:
            pass
        try:
            process.wait(timeout=5)
            return True
        except (OSError, subprocess.TimeoutExpired):
            pass
        try:
            process.send_signal(signal.SIGKILL)
        except OSError:
            pass
        try:
            process.wait(timeout=5)
            return True
        except (OSError, subprocess.TimeoutExpired):
            return False

    def diag_wait_reap():
        try:
            process.wait(timeout=COMMAND_TIMEOUT)
        except subprocess.TimeoutExpired as error:
            reaped = diag_terminate_reap()
            tail = diag_cleanup_tail()
            note = '' if reaped else '\n<child not reaped within bounded cleanup>'
            raise RuntimeError(f'{label} timed out:\n{tail}{note}') from error

    try:
        time.sleep(1)
        if process.poll() is None:
            process.stdin.write('q' if log_handle is None else b'q')
            process.stdin.flush()
        if log_handle is None:
            output, _ = process.communicate(timeout=COMMAND_TIMEOUT)
        else:
            process.stdin.close()
            diag_wait_reap()
            output = diag_cleanup_tail()
            if output:
                print(f'{label} diagnostic tail:\n{output}', file=sys.stderr)
    except (BrokenPipeError, OSError):
        if log_handle is None:
            output, _ = process.communicate(timeout=COMMAND_TIMEOUT)
        else:
            try:
                process.stdin.close()
            except (BrokenPipeError, OSError):
                pass
            diag_wait_reap()
            output = diag_cleanup_tail()
            if output:
                print(f'{label} diagnostic tail:\n{output}', file=sys.stderr)
    except subprocess.TimeoutExpired as error:
        if log_handle is None:
            process.send_signal(signal.SIGTERM)
            process.communicate(timeout=5)
            raise RuntimeError(f'{label} timed out:\n{error.stdout or ""}') from error
        try:
            process.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        reaped = diag_terminate_reap()
        tail = diag_cleanup_tail()
        note = '' if reaped else '\n<child not reaped within bounded cleanup>'
        raise RuntimeError(f'{label} timed out:\n{tail}{note}') from error
    finally:
        if log_handle is not None:
            try:
                log_handle.close()
            except OSError:
                pass

    if process.returncode != 0:
        raise RuntimeError(
            f'{label} failed with exit code {process.returncode}:\n{output}'
        )


def make_fixture(ffmpeg, directory, name, codec, format_name=None):
    output = Path(directory) / name
    command = [
        ffmpeg,
        '-hide_banner',
        '-loglevel',
        'error',
        '-y',
        '-f',
        'lavfi',
        '-i',
        'sine=frequency=440:duration=0.25',
        '-ac',
        '2',
        '-ar',
        '48000',
        '-c:a',
        codec,
    ]
    if format_name:
        command.extend(['-f', format_name])
    command.append(str(output))
    completed = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(f'fixture generation failed for {name}:\n{completed.stdout}')
    return output


def main():
    ffmpeg = shutil.which('ffmpeg')
    if not ffmpeg:
        raise RuntimeError('ffmpeg is required to generate playback fixtures')
    if not PLAYER.is_file():
        raise RuntimeError(f'player executable does not exist: {PLAYER}')

    with tempfile.TemporaryDirectory(prefix='tizonia-playback-smoke-') as directory:
        directory = Path(directory)
        config = directory / 'tizonia.conf'
        config.write_text(
            '[ilcore]\n'
            f'component-paths = {";".join(PLUGIN_PATHS)};\n\n'
            '[resource-management]\n'
            'enabled = false\n\n'
            '[plugins]\n'
            'OMX.Aratelia.audio_renderer.alsa.pcm.alsa_device = null\n\n'
            '[tizonia]\n'
            'default-audio-renderer = OMX.Aratelia.audio_renderer.alsa.pcm\n'
            'mpris-enabled = false\n',
            encoding='utf-8',
        )
        env = os.environ.copy()
        env.pop('TIZ_SMOKE_FLAC_MARK', None)
        env['TIZONIA_RC_FILE'] = str(config)
        env['HOME'] = str(directory)

        role_expectations = {
            'audio_reader.binary': ['OMX.Aratelia.file_reader.binary'],
            'audio_decoder.mp3': ['OMX.Aratelia.audio_decoder.mp3'],
            'audio_decoder.flac': ['OMX.Aratelia.audio_decoder.flac'],
            'audio_decoder.vorbis': ['OMX.Aratelia.audio_decoder.vorbis'],
            'audio_decoder.opus': [
                'OMX.Aratelia.audio_decoder.opus',
                'OMX.Aratelia.audio_decoder.opusfile.opus',
            ],
            'audio_decoder.pcm': ['OMX.Aratelia.audio_decoder.pcm'],
            'audio_source.http': ['OMX.Aratelia.audio_source.http'],
            'source.container_demuxer.ogg': [
                'OMX.Aratelia.container_demuxer.ogg',
            ],
            'audio_renderer.pcm': [
                'OMX.Aratelia.audio_renderer.alsa.pcm',
                'OMX.Aratelia.audio_renderer.pulseaudio.pcm',
            ],
        }
        for role, expected_components in role_expectations.items():
            components = run_checked(
                [str(PLAYER), '--comps-of-role', role],
                env=env,
                label=f'role discovery ({role})',
            )
            missing = [
                name for name in expected_components if name not in components
            ]
            if missing:
                raise RuntimeError(
                    f'{role} discovery did not find: {", ".join(missing)}\n'
                    f'{components}'
                )

        fixtures = [
            make_fixture(ffmpeg, directory, 'sample.mp3', 'libmp3lame'),
            make_fixture(ffmpeg, directory, 'sample.flac', 'flac'),
            make_fixture(ffmpeg, directory, 'sample.ogg', 'libvorbis', 'ogg'),
            make_fixture(ffmpeg, directory, 'sample.opus', 'libopus', 'ogg'),
            make_fixture(ffmpeg, directory, 'sample.wav', 'pcm_s16le'),
        ]
        for fixture in fixtures:
            label = f'local playback ({fixture.suffix})'
            if fixture.suffix == '.flac':
                flac_env = env.copy()
                flac_env['TIZ_SMOKE_FLAC_MARK'] = '1'
                play(str(fixture), env=flac_env, label=label,
                     diag_log=directory / 'flac-child.log')
            else:
                play(str(fixture), env=env, label=label)

        handler = functools.partial(QuietHandler, directory=str(directory))
        server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            url = f'http://127.0.0.1:{server.server_port}/sample.mp3'
            play(url, env=env, label='direct HTTP playback')
        finally:
            server.shutdown()
            server.server_close()
            thread.join(timeout=5)

    print('playback smoke checks passed')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:  # pylint: disable=broad-except
        print(f'playback smoke checks failed: {error}', file=sys.stderr)
        sys.exit(1)
