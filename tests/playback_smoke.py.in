#!/usr/bin/env python3
"""Headless, deterministic local playback checks for the core stack."""

import functools
import http.server
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time


PLAYER = Path('@player@')
PLUGIN_PATHS = '@plugin_paths@'.split(';')
COMMAND_TIMEOUT = 20


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, _format, *_args):
        pass


def run_checked(command, *, env, label):
    try:
        completed = subprocess.run(
            command,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=COMMAND_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f'{label} timed out') from error
    if completed.returncode != 0:
        raise RuntimeError(
            f'{label} failed with exit code {completed.returncode}:\n'
            f'{completed.stdout}'
        )
    return completed.stdout


def play(uri, *, env, label):
    """Start a player graph, allow it to initialise, then quit cleanly."""
    try:
        process = subprocess.Popen(
            [str(PLAYER), uri],
            env=env,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
    except OSError as error:
        raise RuntimeError(f'{label} could not start: {error}') from error

    try:
        time.sleep(1)
        if process.poll() is None:
            process.stdin.write('q')
            process.stdin.flush()
        output, _ = process.communicate(timeout=COMMAND_TIMEOUT)
    except (BrokenPipeError, OSError):
        output, _ = process.communicate(timeout=COMMAND_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        process.send_signal(signal.SIGTERM)
        process.communicate(timeout=5)
        raise RuntimeError(f'{label} timed out:\n{error.stdout or ""}') from error

    if process.returncode != 0:
        raise RuntimeError(
            f'{label} failed with exit code {process.returncode}:\n{output}'
        )


def make_fixture(ffmpeg, directory, name, codec, format_name=None):
    output = Path(directory) / name
    command = [
        ffmpeg,
        '-hide_banner',
        '-loglevel',
        'error',
        '-y',
        '-f',
        'lavfi',
        '-i',
        'sine=frequency=440:duration=0.25',
        '-ac',
        '2',
        '-ar',
        '44100',
        '-c:a',
        codec,
    ]
    if format_name:
        command.extend(['-f', format_name])
    command.append(str(output))
    completed = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(f'fixture generation failed for {name}:\n{completed.stdout}')
    return output


def main():
    ffmpeg = shutil.which('ffmpeg')
    if not ffmpeg:
        raise RuntimeError('ffmpeg is required to generate playback fixtures')
    if not PLAYER.is_file():
        raise RuntimeError(f'player executable does not exist: {PLAYER}')

    with tempfile.TemporaryDirectory(prefix='tizonia-playback-smoke-') as directory:
        directory = Path(directory)
        config = directory / 'tizonia.conf'
        config.write_text(
            '[ilcore]\n'
            f'component-paths = {";".join(PLUGIN_PATHS)};\n\n'
            '[resource-management]\n'
            'enabled = false\n\n'
            '[plugins]\n'
            'OMX.Aratelia.audio_renderer.alsa.pcm.alsa_device = null\n\n'
            '[tizonia]\n'
            'default-audio-renderer = OMX.Aratelia.audio_renderer.alsa.pcm\n'
            'mpris-enabled = false\n',
            encoding='utf-8',
        )
        env = os.environ.copy()
        env['TIZONIA_RC_FILE'] = str(config)
        env['HOME'] = str(directory)

        components = run_checked(
            [str(PLAYER), '--comp-list'], env=env, label='plugin discovery'
        )
        expected_components = [
            'OMX.Aratelia.audio_decoder.mp3',
            'OMX.Aratelia.audio_decoder.flac',
            'OMX.Aratelia.audio_decoder.vorbis',
            'OMX.Aratelia.audio_decoder.opus',
            'OMX.Aratelia.audio_decoder.pcm',
            'OMX.Aratelia.audio_source.http',
            'OMX.Aratelia.container_demuxer.ogg',
            'OMX.Aratelia.audio_renderer.alsa.pcm',
            'OMX.Aratelia.audio_renderer.pulseaudio.pcm',
        ]
        missing = [name for name in expected_components if name not in components]
        if missing:
            raise RuntimeError(f'plugin discovery did not find: {", ".join(missing)}\n{components}')

        roles = run_checked(
            [str(PLAYER), '--comps-of-role', 'audio_decoder.mp3'],
            env=env,
            label='role discovery',
        )
        if 'OMX.Aratelia.audio_decoder.mp3' not in roles:
            raise RuntimeError(f'MP3 decoder role was not discovered:\n{roles}')

        renderer_roles = run_checked(
            [str(PLAYER), '--comps-of-role', 'audio_renderer.pcm'],
            env=env,
            label='renderer discovery',
        )
        missing_renderers = [
            name
            for name in (
                'OMX.Aratelia.audio_renderer.alsa.pcm',
                'OMX.Aratelia.audio_renderer.pulseaudio.pcm',
            )
            if name not in renderer_roles
        ]
        if missing_renderers:
            raise RuntimeError(
                f'renderer role was not discovered: {", ".join(missing_renderers)}\n'
                f'{renderer_roles}'
            )

        fixtures = [
            make_fixture(ffmpeg, directory, 'sample.mp3', 'libmp3lame'),
            make_fixture(ffmpeg, directory, 'sample.flac', 'flac'),
            make_fixture(ffmpeg, directory, 'sample.ogg', 'libvorbis', 'ogg'),
            make_fixture(ffmpeg, directory, 'sample.opus', 'libopus', 'ogg'),
            make_fixture(ffmpeg, directory, 'sample.wav', 'pcm_s16le'),
        ]
        for fixture in fixtures:
            play(str(fixture), env=env, label=f'local playback ({fixture.suffix})')

        handler = functools.partial(QuietHandler, directory=str(directory))
        server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            url = f'http://127.0.0.1:{server.server_port}/sample.mp3'
            play(url, env=env, label='direct HTTP playback')
        finally:
            server.shutdown()
            server.server_close()
            thread.join(timeout=5)

    print('playback smoke checks passed')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:  # pylint: disable=broad-except
        print(f'playback smoke checks failed: {error}', file=sys.stderr)
        sys.exit(1)
